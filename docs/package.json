{
  "name": "codestrata-docs",
  "version": "0.2.0",
  "private": true,
  "description": "CodeStrata public documentation portal (docs.codestrata.ai)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "npm run build && node scripts/validate.mjs && node scripts/community-api-contract.mjs",
    "validate": "node scripts/validate.mjs && node scripts/community-api-contract.mjs",
    "visual:capture": "node scripts/visual-capture.mjs",
    "theme:validate": "node scripts/theme-validate.mjs",
    "a11y:responsive": "node scripts/a11y-responsive-validate.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:upload": "wrangler deploy",
    "deploy": "npm run deploy:upload",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:local": "npm run build && npm run deploy:check && npm run deploy:upload"
  },
  "devDependencies": {
    "playwright": "^1.52.0",
    "vitepress": "^1.6.3",
    "wrangler": "4.120.0"
  }
}
