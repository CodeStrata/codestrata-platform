/**
 * CodeStrata Community documentation — Cloudflare Static Assets (Slice 14.12).
 *
 * Package root / Cloudflare project working directory: this docs/ directory.
 * VitePress output (proven): ./.vitepress/dist
 *
 * Do NOT set assets.directory to "docs/.vitepress/dist" — that path is the
 * monorepo-relative location and does not exist relative to this package root.
 * That mismatch is the v0.1.0 deployment failure class.
 *
 * Pure static assets: no Worker main entrypoint, no nodejs_compat, no
 * observability. Compatibility date is intentional and checked-in (not generated).
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codestrata-docs",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page"
  }
}
