# Example remote backend — copy to backend.tf and fill with YOUR values.
# Do not commit a live backend.tf containing account-specific identifiers.
#
# Requirements for production remote state:
# - Encrypted S3 bucket dedicated to OpenTofu/Terraform state (NOT the
#   Community Data Lake)
# - Native S3 lockfile locking (use_lockfile = true) — NO DynamoDB lock table
# - Restricted IAM for state object + lockfile access
# - Versioning enabled on the state bucket
# - Block Public Access enabled
# - Backup/recovery via S3 Versioning; stale locks via OpenTofu procedures
# - Separate state per environment (production vs future dev/staging)

# terraform {
#   backend "s3" {
#     bucket       = "REPLACE_WITH_STATE_BUCKET_NAME"
#     key          = "codestrata/community-cloud/production/terraform.tfstate"
#     region       = "us-west-2"
#     encrypt      = true
#     use_lockfile = true
#   }
# }
