# Local OpenTofu / Terraform artifacts — never commit
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lockfiles are tracked for reproducible validation (Slice 16.5).
# Do not ignore .terraform.lock.hcl

# Variable files with real values
*.auto.tfvars
*.auto.tfvars.json
terraform.tfvars
tofu.tfvars
secrets.tfvars
*.secrets.tfvars

# Live backend config with resolved bucket names (operator-local)
backend.hcl
**/backend.hcl

# Bootstrap operator-local evidence / tfvars
bootstrap/**/.local/
**/bootstrap/**/.local/

# Credentials and keys
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
credentials
credentials.json
aws-credentials

# Build / packaging outputs
build/
dist/
*.zip
*.tar
*.tar.gz
image-id.txt
image-digest.txt

# Verification reports (generated)
reports/

# OS / editor
.DS_Store
.idea/
.vscode/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Live backend config (account/bucket specific) — never commit
backend.hcl
**/backend.hcl

# Production plan artifacts (Slice 17.4) — never commit
production/**/.local/
**/production/**/.local/
