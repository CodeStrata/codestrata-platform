{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OidcProviderManageGitHub",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:ListOpenIDConnectProviders",
        "iam:TagOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint",
        "iam:AddClientIDToOpenIDConnectProvider"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageCodeStrataGitHubRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:role/codestrata-github-actions-production"
      ]
    },
    {
      "Sid": "ManageCodeStrataGitHubPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:TagPolicy",
        "iam:ListEntitiesForPolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:policy/CodeStrataGitHubRemoteStateAccess",
        "arn:aws:iam::*:policy/CodeStrataGitHubInfrastructurePlan",
        "arn:aws:iam::*:policy/CodeStrataGitHubInfrastructureApply"
      ]
    },
    {
      "Sid": "PassNotRequiredForOidcBootstrap",
      "Effect": "Allow",
      "Action": [
        "iam:SimulatePrincipalPolicy",
        "iam:GetContextKeysForPrincipalPolicy"
      ],
      "Resource": "*"
    }
  ]
}
