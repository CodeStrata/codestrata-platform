{
  "policy_id": "community-insights-event-coverage-policy",
  "policy_version": "1.0",
  "slice": "15.3",
  "epic": 15,
  "depends_on": [
    "community-data-lake-policy:1.0",
    "community-analytics-partition-policy:1.0"
  ],
  "authority": "Existing Community Cloud event contracts are authoritative. Dashboard requirements cannot override telemetry privacy.",
  "partition_redesign_required": false,
  "path_layout_unchanged": true,
  "runtime_ingestion_changes_allowed": false,
  "schema_activation_allowed_in_15_3": false,
  "aggregations_allowed_in_15_3": false,
  "apis_allowed_in_15_3": false,
  "dashboard_ui_allowed_in_15_3": false,
  "start_slice_15_7": true,
  "existing_event_contracts_authoritative": true,
  "metrics_must_derive_from_approved_fields": true,
  "raw_customer_source_data_forbidden": true,
  "schema_changes_must_be_additive_and_privacy_reviewed": true,
  "model_adoption_restricted_by_privacy": true,
  "model_adoption_decision": "C_normalized_model_family_allowed",
  "validation_dataset_growth_external": true,
  "streams": [
    "telemetry",
    "assessment_metadata",
    "cli_event",
    "extension_event",
    "ai_usage"
  ],
  "schema_versions": {
    "lake_envelope": "1.0",
    "community-telemetry": "1.0",
    "community-assessment-metadata": "1.0",
    "community-cli-event": "1.0",
    "community-extension-event": "1.0",
    "community-ai-usage": "1.0"
  },
  "installation_identity": {
    "field": "payload.installation_id",
    "platform_optional": true,
    "generated_by_platform": false,
    "engine_generation": "uuid_v4",
    "engine_persistence": "~/.codestrata/anonymous-installation-identity.json",
    "vscode_epic10_identity_free": true,
    "cli_vs_vscode_same_installation": "not_guaranteed_independent_clients",
    "reset_behavior": "no_auto_regenerate_valid_id; recover_on_corruption_may_mint_new",
    "stable_enough_for_unique_count": "yes_when_present_with_documented_undercount",
    "redesign_in_15_3": false
  },
  "activity_definition": {
    "active_installation": "anonymous installation_id observed on an approved activity event within the window",
    "approved_activity_sources": [
      {
        "stream": "assessment_metadata",
        "rule": "any accepted assessment_metadata_submitted event"
      },
      {
        "stream": "telemetry",
        "rule": "event_type in feature_invoked|feature_completed|application_started|application_completed|operation_failed"
      },
      {
        "stream": "cli_event",
        "rule": "event.operation in assess|assess_with_ai (primary); other ops secondary"
      },
      {
        "stream": "extension_event",
        "rule": "event.operation in assess|assess_with_ai (usage); activate alone is NOT usage"
      },
      {
        "stream": "ai_usage",
        "rule": "any accepted ai_usage event"
      }
    ],
    "do_not_count": [
      "raw_event_count_without_installation_id",
      "extension_activate_alone_as_usage",
      "open_report_as_assessment_failure"
    ]
  },
  "assessment_success_failure": {
    "authoritative_status": "payload.assessment.assessment_status",
    "authoritative_result": "payload.execution.result",
    "success_values": {
      "assessment_status": [
        "completed",
        "partially_completed"
      ],
      "execution.result": [
        "succeeded",
        "partially_succeeded"
      ]
    },
    "failure_values": {
      "assessment_status": [
        "failed"
      ],
      "execution.result": [
        "failed"
      ]
    },
    "not_authoritative": [
      "open_report",
      "report_json_generated_false",
      "cli_event.open"
    ]
  },
  "ai_model_privacy": {
    "outcome": "C",
    "allowed_field": "payload.usage.model_family",
    "forbidden_fields": [
      "model_id",
      "exact_model",
      "raw_model_identifier"
    ],
    "exact_model_collection_permitted": false
  },
  "ai_provider_vocab": {
    "allowed_field": "payload.usage.provider_family",
    "canonical_today": [
      "aws_bedrock",
      "openai",
      "openrouter",
      "unavailable"
    ],
    "alias_bedrock": "aws_bedrock",
    "openrouter_present": true,
    "credentials_forbidden": true
  },
  "vscode_usage_definition": {
    "stream": "extension_event",
    "usage_operations": [
      "assess",
      "assess_with_ai"
    ],
    "activate_alone_counts_as_usage": false,
    "version_field": "payload.client.version"
  },
  "validation_dataset_growth": {
    "classification": "external_metric_source",
    "authoritative_source": "validation/repository-catalog/catalog.json",
    "schema_name": "codestrata-repository-catalog",
    "force_into_telemetry": false
  },
  "schema_classifications": {
    "community-telemetry": "sufficient_with_optionality_limitation",
    "community-assessment-metadata": "sufficient_with_optionality_limitation",
    "community-cli-event": "sufficient_with_optionality_limitation",
    "community-extension-event": "sufficient_with_optionality_limitation",
    "community-ai-usage": "sufficient_with_optionality_limitation",
    "lake-envelope": "sufficient_no_change",
    "named_package_ecosystem_dimension": "sufficient_no_change",
    "openrouter_provider_family": "sufficient_no_change",
    "validation_dataset_growth": "external_metric",
    "exact_model_id_metric": "metric_deferred_for_privacy"
  },
  "change_register": [
    {
      "change_id": "CR-15.3-001",
      "title": "optional_named_package_ecosystem_label",
      "status": "implemented_in_15_4",
      "activated_in_runtime": true,
      "privacy_reviewed": true,
      "description": "Additive optional categorical field for package-ecosystem label if product requires named ecosystems beyond primary_language. Must not include package names, deps, paths, or repos.",
      "production_wire_enabled": false
    },
    {
      "change_id": "CR-15.3-002",
      "title": "openrouter_provider_family_catalog_entry",
      "status": "implemented_in_15_4",
      "activated_in_runtime": true,
      "privacy_reviewed": true,
      "description": "If OpenRouter becomes an Engine integration, add provider_family openrouter (or alias) to ai-provider-family-catalog. No credentials/endpoints.",
      "production_wire_enabled": false
    },
    {
      "change_id": "CR-15.3-003",
      "title": "vscode_installation_id_when_lake_wired",
      "status": "implemented_in_15_4",
      "activated_in_runtime": true,
      "privacy_reviewed": true,
      "description": "When VS Code Community Cloud wiring lands, prefer sending approved anonymous installation_id so install/DAU/MAU are not identity-free undercount. Does not redesign identity.",
      "production_wire_enabled": false
    }
  ],
  "metric_coverage": {
