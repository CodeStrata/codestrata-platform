{
  "Version": "2012-10-17",
  "policy_name": "CodeStrataGitHubInfrastructurePlan",
  "status": "contract_defined_not_attached",
  "slice": "17.4",
  "authority": "Read-only AWS permissions for OpenTofu refresh/plan against production Community Cloud. Defined in Slice 17.4; attach may be deferred. No product mutation. No AdministratorAccess. No application secret reads.",
  "Statement": [
    {
      "Sid": "StateBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock"
      ],
      "Resource": [
        "arn:aws:s3:::codestrata-opentofu-state-production-*",
        "arn:aws:s3:::codestrata-opentofu-state-production-*/*"
      ]
    },
    {
      "Sid": "IamReadForRefresh",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LambdaReadForRefresh",
      "Effect": "Allow",
      "Action": [
        "lambda:Get*",
        "lambda:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApiGatewayReadForRefresh",
      "Effect": "Allow",
      "Action": [
        "apigateway:Get*",
        "apigateway:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrReadForRefresh",
      "Effect": "Allow",
      "Action": [
        "ecr:Describe*",
        "ecr:List*",
        "ecr:Get*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsDescribeForRefresh",
      "Effect": "Allow",
      "Action": [
        "logs:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DataLakeBucketNamingReads",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:ListBucket*",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::codestrata-community-data-lake-production",
        "arn:aws:s3:::codestrata-community-data-lake-production/*"
      ]
    },
    {
      "Sid": "CallerIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ],
  "explicitly_denied_or_absent": [
    "AdministratorAccess",
    "s3:PutObject on product buckets via this plan policy",
    "lambda:CreateFunction",
    "lambda:UpdateFunctionCode",
    "ecr:PutImage",
    "apigateway:POST",
    "iam:CreateRole",
    "iam:AttachRolePolicy",
    "secretsmanager:GetSecretValue",
    "secretsmanager:ListSecrets",
    "dynamodb:*",
    "athena:*",
    "glue:*",
    "bedrock:InvokeModel"
  ],
  "notes": [
    "READ-ONLY only — no Create/Update/Delete/Put mutation for product infrastructure.",
    "No secretsmanager GetSecretValue for application secrets; ListSecrets omitted by preference.",
    "No DynamoDB/Athena/Glue/Bedrock invoke.",
    "status contract_defined_not_attached — Slice 17.4 defines; attach may be deferred."
  ]
}
