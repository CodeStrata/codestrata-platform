    {
      "class": "public_report_urls",
      "duration_or_semantics": "while_published_until_revoke_or_superseded_by_current_previous_rotation",
      "source": "report_publishing_runtime"
    },
    {
      "class": "report_artifact_staging",
      "duration_or_semantics": "2_days",
      "source": "infrastructure/modules/community-report-artifacts/lifecycle.tf"
