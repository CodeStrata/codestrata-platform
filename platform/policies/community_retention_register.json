    },
    {
      "class": "local_eir",
      "duration_or_semantics": "current_plus_previous",
      "source": "codestrata-report-retention-policy:1.0"
    },
    {
      "class": "published_assessment_reports",
      "duration_or_semantics": "current_plus_previous_application_enforced",
      "source": "community-report-publishing-policy:1.0"
    },
    {
      "class": "published_eir",
      "duration_or_semantics": "current_plus_previous_application_enforced",
      "source": "community-report-publishing-policy:1.0"
    },
    {
      "class": "data_lake_raw",
      "duration_or_semantics": "365_days",
      "source": "infrastructure/modules/community-data-lake/lifecycle.tf"
    },
    {
      "class": "data_lake_quarantine",
      "duration_or_semantics": "90_days",
      "source": "infrastructure/modules/community-data-lake/lifecycle.tf"
    },
    {
      "class": "identity_prefix",
