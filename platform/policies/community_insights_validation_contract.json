{
  "contract_id": "community-insights-validation-contract",
  "contract_version": "1.0",
  "policy_urn": "community-insights-validation-policy:1.0",
  "offline_validation": true,
  "synthetic_fixtures_required": true,
  "report_must_not_contain": [
    "installation_id_values",
    "passwords",
    "session_tokens",
    "absolute_paths",
    "timestamps",
    "aws_secret_values"
  ],
  "pass_requires": [
    "metric_semantics_correct",
    "privacy_boundary_intact",
    "suppression_correct",
    "bounded_s3_reads",
    "authentication_required",
    "auth_does_not_weaken_privacy",
    "low_cost_overview_batching",
    "dashboard_mappings_correct",
    "standalone_export_builds",
    "production_ingestion_disabled",
    "no_deployment",
    "slice_15_12_not_started",
    "deterministic_verification"
  ],
  "production_ingestion_enabled": false,
  "live_dashboard_data_available": false,
  "start_slice_15_12": true,
  "start_epic_16": false,
  "start_slice_16_2": false,
  "start_slice_16_3": false,
  "start_slice_16_4": false,
  "start_slice_16_5": true,
  "start_slice_16_6": true,
  "start_slice_16_7": true,
  "start_slice_16_8": true,
  "start_slice_16_9": true,
  "start_slice_16_10": true,
  "start_epic_17": false
}
