{
  "policy_id": "community-insights-auth-policy",
  "policy_version": "1.0",
  "slice": "15.9",
  "epic": 15,
  "depends_on": [
    "codestrata-insights-application-policy:1.0",
    "community-insights-aggregation-policy:1.0",
    "community-insights-metrics-policy:1.0"
  ],
  "authority": "Shared-password authentication and short-lived session cookies for the internal Community Insights application and its Platform API boundary.",
  "shared_password_auth": true,
  "individual_accounts": false,
  "cognito": false,
  "oauth": false,
  "social_login": false,
  "mfa": false,
  "secrets_manager_authority": true,
  "frontend_secret_storage": false,
  "server_side_verification": true,
  "session_required": true,
  "http_only_cookie": true,
  "secure_cookie": true,
  "same_site_policy": "Strict",
  "session_ttl_seconds": 28800,
  "logout_supported": true,
  "authentication_required_for_metrics": true,
  "raw_event_access_allowed": false,
  "auth_failure_logging_safe": true,
  "production_deployment_enabled": false,
  "role_model": [
    "authenticated_internal"
  ],
  "password_secret_id": "codestrata/insights/dashboard-password",
  "session_secret_id": "codestrata/insights/session-secret",
  "password_verifier": "scrypt",
  "raw_password_in_secrets_manager_discouraged": true,
  "session_signing_reuses_dashboard_password": false,
  "cookie_name": "cs_insights_session",
  "cookie_path": "/",
  "cookie_host_only": true,
  "api_topology": "same_origin_proxy",
  "api_topology_detail": "https://insights.codestrata.ai/api/v1/insights/... proxies to Platform Community Cloud API. Host-only cookie Path=/ on insights.codestrata.ai. No wildcard CORS with credentials.",
  "future_frontend_origin": "https://insights.codestrata.ai",
  "cors_wildcard_with_credentials": false,
  "csrf_posture": "samesite_strict_plus_origin_check_on_state_changing",
  "rate_limit_posture": "api_gateway_stage_throttle_plus_auth_attempt_group",
  "login_path": "/insights/auth/login",
  "logout_path": "/insights/auth/logout",
  "session_status_path": "/insights/auth/session",
  "overview_path": "/insights/api/overview",
  "absolute_api_prefix": "/api/v1",
  "privacy_independent_of_auth": true,
  "minimum_cohort_suppression_remains": true,
  "start_slice_15_10": true,
  "metric_charts_deferred_to_15_10": false,
  "error_codes": [
    "authentication_required",
    "invalid_credentials",
    "session_expired",
    "invalid_session",
    "authorization_denied",
    "auth_service_unavailable",
    "invalid_origin",
    "rate_limited",
    "internal_auth_error"
  ],
  "security_headers": [
    "Content-Security-Policy",
    "X-Content-Type-Options",
    "Referrer-Policy",
    "X-Frame-Options",
    "Permissions-Policy"
  ],
  "robots": "noindex,nofollow",
  "verification": {
    "package": "verification/community_insights_auth",
    "schema": "community-insights-auth-verification:1.0.0",
    "report": "reports/verification/sv15-9/community-insights-auth-verification.json"
  },
  "start_slice_15_11": true,
  "slice_15_10_allowed": true,
  "start_slice_15_12": true,
  "start_epic_16": false,
  "start_slice_16_2": false,
  "start_slice_16_3": false,
  "start_slice_16_4": false,
  "start_slice_16_5": true,
  "start_slice_16_6": true,
  "start_slice_16_7": true,
  "start_slice_16_8": true,
  "start_slice_16_9": true,
  "start_slice_16_10": true,
  "start_epic_17": false
}
