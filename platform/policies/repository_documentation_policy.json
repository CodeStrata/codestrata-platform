{
  "policy_id": "repository-documentation-policy",
  "policy_version": "1.0",
  "schema": "repository-documentation-policy:1.0",
  "epic": 16,
  "slice": "16.2",
  "authority": "Authoritative Community documentation cleanup and hierarchy for public-ready documentation surfaces.",
  "documentation_only": true,
  "runtime_behavior_change_forbidden": true,
  "api_change_forbidden": true,
  "schema_change_forbidden": true,
  "policy_change_outside_slice_forbidden": true,
  "product_version": "0.2.0",
  "edition": "Community",
  "classifications": [
    "ACTIVE",
    "GENERATED",
    "HISTORICAL",
    "EXPORT_ONLY",
    "OWNER_REVIEW_REQUIRED",
    "DELETE_CANDIDATE",
    "ARCHIVE_CANDIDATE",
    "STALE"
  ],
  "authoritative_document_registry": {
    "readme": "README.md",
    "installation": "docs/getting-started/install.md",
    "release": "CHANGELOG.md",
    "release_portal": "docs/reference/release-notes.md",
    "documentation_hierarchy": "docs/",
    "community_portal_entry": "docs/index.md",
    "architecture_monorepo": "ARCHITECTURE.md",
    "architecture_portal": "docs/ARCHITECTURE.md",
    "contributing_monorepo": "CONTRIBUTING.md",
    "privacy_community": "docs/security/privacy.md",
    "telemetry_community": "docs/reference/telemetry.md",
    "design_system": "design-system/README.md",
    "design_system_tokens": "design-system/tokens/tokens.css",
    "vscode_marketplace": "vscode-plugin/README.md",
    "engine_maintainer_docs": "engine/docs/README.md",
    "platform_internal_docs": "platform/docs/README.md",
    "security_community": "docs/SECURITY.md",
    "code_of_conduct_community": "engine/CODE_OF_CONDUCT.md",
    "license_community_engine": "engine/LICENSE"
  },
  "documentation_hierarchy": {
    "public_community": "docs/",
    "engine_maintainer": "engine/docs/",
    "platform_internal": "platform/docs/",
    "design_system": "design-system/documentation/",
    "knowledge": "knowledge/",
    "examples": "examples/",
    "vscode": "vscode-plugin/docs/",
    "insights_internal": "insights/docs/",
    "governance": "governance/",
    "verification_readmes": "verification/*/README.md"
  },
  "active_community_rules": [
    "describe_current_v0_2_0_community_product",
    "reference_current_architecture",
    "no_stale_product_history_as_current",
    "no_unavailable_platform_features_as_community",
    "no_aimf_active_identity",
    "no_cursor_extension_active_identity",
    "no_broken_relative_links_in_active_docs",
    "one_authoritative_document_per_subject"
  ],
  "excluded_from_community_publish": [
    "docs/platform/**",
    "docs/internal/**",
    "docs/community/vs-platform.md"
  ],
  "historical_knowledge_deletion_forbidden": true,
  "generated_docs_manual_edit_forbidden": true,
  "start_slice_16_3": true,
  "verification": {
    "package": "verification/repository_documentation",
    "schema": "repository-documentation-verification:1.0.0",
    "report": "reports/verification/sv16-2/repository-documentation-verification.json",
    "cleanup_guide": "platform/docs/repository-cleanup/community-documentation-cleanup.md"
  },
  "start_slice_16_4": true,
  "start_slice_16_5": true,
  "start_slice_16_6": true,
  "start_slice_16_7": true,
  "start_slice_16_8": true,
  "start_slice_16_9": true,
  "start_slice_16_10": true,
  "start_epic_17": false
}
