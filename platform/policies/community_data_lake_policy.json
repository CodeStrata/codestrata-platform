  "python_source_of_truth": "platform/src/codestrata_platform/community_cloud_api/data_lake/policy.py",
  "envelope_schema_version": "1.0",
  "bucket_strategy": "single_bucket_prefix_isolation",
  "bucket_name_pattern": "{project}-community-data-lake-{environment}",
  "default_bucket_name": "codestrata-community-data-lake-production",
  "accepted_prefix": "raw/",
  "quarantine_prefix": "quarantine/",
  "hive_style_partitions": true,
  "accepted_partition_path": "raw/stream=<stream>/schema_version=<ver>/year=<YYYY>/month=<MM>/day=<DD>/<opaque>.json",
  "quarantine_partition_path": "quarantine/reason=<safe_reason>/year=<YYYY>/month=<MM>/day=<DD>/<opaque>.json",
  "allowed_event_streams": [
    "telemetry",
    "assessment_metadata",
    "cli_event",
    "extension_event",
    "ai_usage"
