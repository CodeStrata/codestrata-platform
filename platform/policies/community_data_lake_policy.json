  "installation_id_payload_only": true,
  "anonymous_installation_identity_policy": "community-anonymous-installation-identity-policy:1.0",
  "privacy_first_telemetry_required": true,
  "public_export_allowed": false,
  "ownership": "platform-private",
  "dashboard_consumer": "Community Insights Dashboard (future; not started in 15.1)",
  "dashboard_ready_for_implementation": false,
  "dashboard_storage_contract_ready": true,
  "aggregations_allowed_in_15_1": false,
  "apis_allowed_in_15_1": false,
  "authentication_redesign_allowed_in_15_1": false,
  "telemetry_redesign_allowed": false,
