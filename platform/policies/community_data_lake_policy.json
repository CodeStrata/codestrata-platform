  "object_filename": "opaque_hex.json",
  "encryption_mode": "sse_s3",
  "enable_versioning": true,
  "accepted_retention_days": 365,
  "quarantine_retention_days": 90,
  "incomplete_multipart_days": 7,
  "noncurrent_version_expiration_days": 30,
  "max_envelope_bytes": 70000,
  "enable_ingestion_wire": false,
  "writer_iam_attached": false,
  "community_only": true,
  "customer_source_code_allowed": false,
  "personal_identifiers_allowed": false,
