{
  "policy_id": "repository-package-release-validation-policy",
  "policy_version": "1.0",
  "schema": "repository-package-release-validation-policy:1.0",
  "epic": 16,
  "slice": "16.9",
  "authority": "Validate exported public/community and private standalone repositories are independently releasable. Validation only \u2014 no publish/deploy/tag/commit.",
  "export_targets": [
    "community",
    "infrastructure",
    "insights"
  ],
  "community_exported_repositories": [
    "codestrata-engine",
    "codestrata-examples",
    "codestrata-vscode",
    "codestrata-docs"
  ],
  "standalone_repositories": [
    "codestrata-engine",
    "codestrata-docs",
    "codestrata-insights",
    "codestrata-infrastructure",
    "codestrata-vscode",
    "codestrata-examples"
  ],
  "validation_surfaces": [
    "export_validation",
    "standalone_repository",
    "standalone_build",
    "package_validation",
    "release_artifact_validation",
    "public_repository_audit",
    "security_validation",
    "export_determinism"
  ],
  "required_root_files": [
    "README.md",
    "LICENSE",
    "SECURITY.md",
    ".gitignore"
  ],
  "recommended_root_files": [
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md"
  ],
  "forbidden_in_exports": [
    "platform/src",
    "commercial prototype runtime",
    "verification packages unless intentionally exported",
    "internal platform docs",
    "generated build outputs",
    "temporary files",
    "secrets"
  ],
  "no_publish": true,
  "no_deploy": true,
  "no_tag": true,
  "no_commit": true,
  "no_marketplace_publish": true,
  "no_pypi_publish": true,
  "no_github_release": true,
  "no_runtime_redesign": true,
  "no_repository_moves": true,
  "production_ingestion_enabled": false,
  "start_slice_16_9": true,
  "start_slice_16_10": true,
  "start_epic_17": false,
  "verification": {
    "package": "verification/repository_package_release_validation",
    "schema": "repository-package-release-validation-verification:1.0.0",
    "contract": "platform/contracts/repository_package_release_validation_verification.json",
    "report": "reports/verification/sv16-9/repository-package-release-validation-verification.json"
  }
}
