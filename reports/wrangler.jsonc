/**
 * CodeStrata public report delivery — thin Cloudflare Worker shell + landing assets.
 *
 * Package root: reports/
 * Custom domain: reports.codestrata.ai
 * Upstream: https://api.codestrata.ai (never S3)
 *
 * "/" is static assets (public/). /r/* is Worker → API (run_worker_first).
 * Never commit Cloudflare API tokens.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codestrata-reports",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "main": "workers/delivery.ts",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/r/*"]
  },
  "routes": [
    {
      "pattern": "reports.codestrata.ai",
      "custom_domain": true
    }
  ],
  "vars": {
    "UPSTREAM_API_BASE": "https://api.codestrata.ai"
  }
}
