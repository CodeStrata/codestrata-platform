{
  "schema": "codestrata-brand-asset-contract",
  "schema_version": "1.0.0",
  "design_system_version": "1.0",
  "policy": "codestrata-brand-asset-policy:1.0",
  "token_authority": "design-system/tokens/catalog.json",
  "master_home": "design-system/assets/brand",
  "generator": "scripts/generate_brand_assets.py",
  "raster_generator": "vscode-plugin/scripts/generate_marketplace_visuals.py",
  "authority": {
    "product_visual_authority": "design-system",
    "master_brand_mark": "codestrata-mark",
    "master_wordmark": "codestrata-wordmark",
    "single_master_required": true,
    "governance_package": {
      "path": "governance/assets",
      "status": "historical_archive",
      "authoritative": false,
      "role": "authored geometry lineage for the strata bar system and outlined wordmark",
      "identity_era": "amber"
    }
  },
  "geometry": {
    "mark_grid": 22,
    "mark_bars": [
      { "x": 1, "y": 3, "width": 20, "height": 3 },
      { "x": 4, "y": 8, "width": 17, "height": 3 },
      { "x": 1, "y": 13, "width": 14, "height": 3 },
      { "x": 6, "y": 18, "width": 12, "height": 3 }
    ],
    "bar_radius": 1.2,
    "bar_order_tokens": ["colors.muted", "colors.teal_dark", "colors.teal", "colors.rust"],
    "monochrome_opacity_ladder": [1.0, 0.78, 0.56, 0.38],
    "simplified_bar_count": 3,
    "simplified_opacity_ladder": [1.0, 0.72, 0.44]
  },
  "color_behavior": {
    "full_color_backgrounds": ["colors.canvas", "colors.paper", "colors.paper_soft"],
    "dark_background_treatment": "monochrome_light",
    "dark_background_token": "colors.night_ink",
    "dark_plate_token": "colors.night",
    "host_controlled_treatment": "currentColor",
    "prohibited_legacy_hex": ["#d98a3d", "#4fb3a5", "#5c6675", "#8b95a5", "#b06a24", "#0f1216"]
  },
  "clear_space": {
    "unit": "bar_height",
    "minimum_clear_space": 1,
    "note": "Keep at least one strata bar height of empty space on every side of the mark or lockup."
  },
  "minimum_size": {
    "full_lockup_min_width_px": 120,
    "mark_min_size_px": 16,
    "simplified_mark_min_size_px": 16,
    "simplified_mark_max_size_px": 24,
    "wordmark_min_width_px": 96,
    "note": "Below 24px use the simplified monochrome mark; never scale the lockup below 120px wide."
  },
  "assets": [
    {
      "id": "codestrata-mark",
      "path": "design-system/assets/brand/codestrata-mark.svg",
      "role": "product_identity_mark",
      "authority": "master",
      "derivative_type": "master",
      "format": "svg",
      "source": null,
      "backgrounds": ["light"],
      "color_behavior": "design_system_full_color",
      "min_size_px": 16,
      "surfaces": ["design_system", "documentation_site"],
      "status": "active"
    },
    {
      "id": "codestrata-mark-on-dark",
      "path": "design-system/assets/brand/codestrata-mark-on-dark.svg",
      "role": "product_identity_mark",
      "authority": "approved_derivative",
      "derivative_type": "approved_dark_variant",
      "format": "svg",
      "source": "codestrata-mark",
      "backgrounds": ["dark"],
      "color_behavior": "monochrome_light",
      "min_size_px": 16,
      "surfaces": ["documentation_site"],
      "status": "active"
    },
    {
      "id": "codestrata-mark-mono",
      "path": "design-system/assets/brand/codestrata-mark-mono.svg",
      "role": "product_identity_mark",
      "authority": "approved_derivative",
      "derivative_type": "approved_monochrome_variant",
      "format": "svg",
      "source": "codestrata-mark",
      "backgrounds": ["light", "dark", "print"],
      "color_behavior": "current_color",
      "min_size_px": 16,
      "surfaces": ["assessment_report", "engineering_intelligence_report"],
      "status": "active"
    },
    {
      "id": "codestrata-mark-simplified-mono",
      "path": "design-system/assets/brand/codestrata-mark-simplified-mono.svg",
      "role": "product_identity_mark",
      "authority": "approved_derivative",
      "derivative_type": "vscode_activity_derivative",
      "format": "svg",
      "source": "codestrata-mark",
      "backgrounds": ["light", "dark"],
      "color_behavior": "current_color",
      "min_size_px": 16,
      "max_size_px": 24,
      "geometry_reduction": "three_bar_simplification",
      "surfaces": ["vscode_extension"],
      "status": "active"
    },
    {
      "id": "codestrata-mark-tile-on-dark",
      "path": "design-system/assets/brand/codestrata-mark-tile-on-dark.svg",
      "role": "product_identity_tile",
      "authority": "approved_derivative",
      "derivative_type": "approved_dark_variant",
      "format": "svg",
      "source": "codestrata-mark",
      "backgrounds": ["dark", "any"],
      "color_behavior": "monochrome_light_on_night_plate",
      "min_size_px": 32,
      "surfaces": ["documentation_site"],
      "status": "active"
    },
    {
      "id": "codestrata-wordmark",
      "path": "design-system/assets/brand/codestrata-wordmark.svg",
      "role": "product_wordmark",
      "authority": "master",
      "derivative_type": "master",
      "format": "svg",
      "source": null,
      "backgrounds": ["light"],
      "color_behavior": "ink_with_teal_dark_accent",
      "outlined": true,
      "font_dependency": false,
      "min_width_px": 96,
      "surfaces": ["documentation_site"],
      "status": "active"
    },
    {
      "id": "codestrata-lockup-horizontal-on-light",
      "path": "design-system/assets/brand/codestrata-lockup-horizontal-on-light.svg",
      "role": "product_lockup",
      "authority": "approved_derivative",
      "derivative_type": "approved_light_variant",
      "format": "svg",
      "source": "codestrata-mark+codestrata-wordmark",
      "backgrounds": ["light"],
      "color_behavior": "design_system_full_color",
      "min_width_px": 120,
      "surfaces": ["documentation_site"],
      "status": "active"
    },
    {
      "id": "codestrata-lockup-horizontal-on-dark",
      "path": "design-system/assets/brand/codestrata-lockup-horizontal-on-dark.svg",
      "role": "product_lockup",
      "authority": "approved_derivative",
      "derivative_type": "approved_dark_variant",
      "format": "svg",
      "source": "codestrata-mark+codestrata-wordmark",
      "backgrounds": ["dark"],
      "color_behavior": "monochrome_light",
      "min_width_px": 120,
      "surfaces": ["documentation_site"],
      "status": "active"
    },
    {
      "id": "docs-favicon",
      "path": "docs/public/favicon.svg",
      "role": "favicon",
      "authority": "consumer_copy",
      "derivative_type": "favicon_derivative",
      "format": "svg",
      "source": "codestrata-mark",
      "byte_identical_to_source": true,
      "backgrounds": ["light", "dark"],
      "color_behavior": "design_system_full_color",
      "surfaces": ["documentation_site"],
      "copy_reason": "documentation repository is exported independently",
      "status": "active"
    },
    {
      "id": "docs-mark",
      "path": "docs/public/brand/icon.svg",
      "role": "product_identity_mark",
      "authority": "consumer_copy",
      "derivative_type": "docs_derivative",
      "format": "svg",
      "source": "codestrata-mark",
      "byte_identical_to_source": true,
      "backgrounds": ["light"],
      "color_behavior": "design_system_full_color",
      "surfaces": ["documentation_site"],
      "copy_reason": "documentation repository is exported independently",
      "status": "active"
    },
    {
      "id": "docs-mark-tile-dark",
      "path": "docs/public/brand/icon-tile-dark.svg",
      "role": "product_identity_tile",
      "authority": "consumer_copy",
      "derivative_type": "docs_derivative",
      "format": "svg",
      "source": "codestrata-mark-tile-on-dark",
      "byte_identical_to_source": true,
      "backgrounds": ["dark", "any"],
      "color_behavior": "monochrome_light_on_night_plate",
      "surfaces": ["documentation_site"],
      "copy_reason": "documentation repository is exported independently",
      "status": "active"
    },
    {
      "id": "docs-lockup-on-light",
      "path": "docs/public/brand/lockup-horizontal-on-light.svg",
      "role": "product_lockup",
      "authority": "consumer_copy",
      "derivative_type": "docs_derivative",
      "format": "svg",
      "source": "codestrata-lockup-horizontal-on-light",
      "byte_identical_to_source": true,
      "backgrounds": ["light"],
      "color_behavior": "design_system_full_color",
      "surfaces": ["documentation_site"],
      "consumer_reference": "docs/.vitepress/config.ts themeConfig.logo.light",
      "copy_reason": "documentation repository is exported independently",
      "status": "active"
    },
    {
      "id": "docs-lockup-on-dark",
      "path": "docs/public/brand/lockup-horizontal-on-dark.svg",
      "role": "product_lockup",
      "authority": "consumer_copy",
      "derivative_type": "docs_derivative",
      "format": "svg",
      "source": "codestrata-lockup-horizontal-on-dark",
      "byte_identical_to_source": true,
      "backgrounds": ["dark"],
      "color_behavior": "monochrome_light",
      "surfaces": ["documentation_site"],
      "consumer_reference": "docs/.vitepress/config.ts themeConfig.logo.dark",
      "copy_reason": "documentation repository is exported independently",
      "status": "active"
    },
    {
      "id": "platform-api-docs-mark",
      "path": "platform/api/openapi/swagger/brand/icon.svg",
      "role": "favicon",
      "authority": "consumer_copy",
      "derivative_type": "website_derivative",
      "format": "svg",
      "source": "codestrata-mark",
      "byte_identical_to_source": true,
      "backgrounds": ["light", "dark"],
      "color_behavior": "design_system_full_color",
      "surfaces": ["platform_api_documentation"],
      "consumer_reference": "platform/api/openapi/swagger/index.html link rel=icon",
      "copy_reason": "Platform API portal serves its own static asset directory",
      "status": "active"
    },
    {
      "id": "platform-api-docs-lockup-on-light",
      "path": "platform/api/openapi/swagger/brand/lockup-horizontal-on-light.svg",
      "role": "product_lockup",
      "authority": "consumer_copy",
      "derivative_type": "website_derivative",
      "format": "svg",
      "source": "codestrata-lockup-horizontal-on-light",
      "byte_identical_to_source": true,
      "backgrounds": ["light"],
      "color_behavior": "design_system_full_color",
      "surfaces": ["platform_api_documentation"],
      "consumer_reference": "platform/api/openapi/swagger/index.html cs-brand__logo--light",
      "copy_reason": "Platform API portal serves its own static asset directory",
      "status": "active"
    },
    {
      "id": "platform-api-docs-lockup-on-dark",
      "path": "platform/api/openapi/swagger/brand/lockup-horizontal-on-dark.svg",
      "role": "product_lockup",
      "authority": "consumer_copy",
      "derivative_type": "website_derivative",
      "format": "svg",
      "source": "codestrata-lockup-horizontal-on-dark",
      "byte_identical_to_source": true,
      "backgrounds": ["dark"],
      "color_behavior": "monochrome_light",
      "surfaces": ["platform_api_documentation"],
      "consumer_reference": "platform/api/openapi/swagger/index.html cs-brand__logo--dark",
      "copy_reason": "Platform API portal serves its own static asset directory",
      "status": "active"
    },
    {
      "id": "assessment-report-mark",
      "path": "engine/src/codestrata/reporting/assets/codestrata-mark-mono.svg",
      "role": "report_identity_mark",
      "authority": "consumer_copy",
      "derivative_type": "report_derivative",
      "format": "svg",
      "source": "codestrata-mark-mono",
      "byte_identical_to_source": true,
      "backgrounds": ["light", "print"],
      "color_behavior": "current_color",
      "surfaces": ["assessment_report"],
      "delivery": "packaged_with_engine_distribution_and_inlined_into_self_contained_html",
      "copy_reason": "Engine distribution and public mirror must render offline",
      "status": "active"
    },
    {
      "id": "eir-report-mark",
      "path": "platform/src/codestrata_platform/intelligence_reporting/presentation/static_html/renderer.py",
      "role": "report_identity_mark",
      "authority": "embedded_copy",
      "derivative_type": "report_derivative",
      "format": "inline_svg",
      "source": "codestrata-mark-mono",
      "markup_identical_to_source": true,
      "backgrounds": ["light", "print"],
      "color_behavior": "current_color",
      "surfaces": ["engineering_intelligence_report"],
      "delivery": "inline_constant_BRAND_MARK_SVG",
      "copy_reason": "commercial Platform must not import Engine presentation modules",
      "status": "active"
    },
    {
      "id": "vscode-activity-icon",
      "path": "vscode-plugin/media/codestrata-activity.svg",
      "role": "vscode_activity_icon",
      "authority": "consumer_copy",
      "derivative_type": "vscode_activity_derivative",
      "format": "svg",
      "source": "codestrata-mark-simplified-mono",
      "byte_identical_to_source": true,
      "backgrounds": ["light", "dark", "high_contrast"],
      "color_behavior": "current_color",
      "min_size_px": 16,
      "max_size_px": 24,
      "surfaces": ["vscode_extension"],
      "consumer_reference": "vscode-plugin/package.json viewsContainers.activitybar[0].icon",
      "copy_reason": "extension repository is packaged and exported independently",
      "status": "active"
    },
    {
      "id": "marketplace-icon",
      "path": "vscode-plugin/media/codestrata-icon.png",
      "role": "marketplace_package_icon",
      "authority": "approved_derivative",
      "derivative_type": "marketplace_derivative",
      "format": "png",
      "source": "codestrata-mark",
      "dimensions": [128, 128],
      "backgrounds": ["light_plate"],
      "color_behavior": "design_system_full_color_on_paper_plate",
      "surfaces": ["vscode_marketplace"],
      "consumer_reference": "vscode-plugin/package.json icon",
      "generated": true,
      "status": "active"
    },
    {
      "id": "marketplace-icon-governance-copy",
      "path": "governance/assets/extension-branding/codestrata-marketplace-icon-derivative-128.png",
      "role": "marketplace_package_icon",
      "authority": "authorized_duplicate",
      "derivative_type": "marketplace_derivative",
      "format": "png",
      "source": "marketplace-icon",
      "dimensions": [128, 128],
      "surfaces": ["publication_runbook"],
      "copy_reason": "publication runbook keeps the shipped derivative alongside its checklist",
      "generated": true,
      "status": "active"
    },
    {
      "id": "marketplace-banner",
      "path": "vscode-plugin/media/marketplace-banner.png",
      "role": "marketplace_gallery_art",
      "authority": "gallery_asset",
      "derivative_type": "marketplace_derivative",
      "format": "png",
      "source": "design_system_tokens",
      "surfaces": ["vscode_marketplace"],
      "owning_slice": "14.6",
      "generated": true,
      "status": "active"
    }
  ],
  "screenshot_assets": {
    "owning_slice": "14.6",
    "paths": [
      "vscode-plugin/media/screenshot-assessment.png",
      "vscode-plugin/media/screenshot-report.png",
      "vscode-plugin/media/screenshot-progress.png",
      "vscode-plugin/media/screenshot-initialization.png",
      "vscode-plugin/media/screenshot-ai-assessment.png"
    ],
    "brand_asset": false,
    "redesign_allowed_in_14_10": false
  },
  "fixture_assets": {
    "paths": ["docs/visual-baselines", "validation/repos", "test-fixtures", "**/testdata", "**/fixtures"],
    "role": "visual_regression_and_analysis_fixture",
    "third_party_branding": true,
    "exported": false,
    "brand_asset": false
  },
  "documentation_capture_assets": {
    "paths": ["engine/docs/images"],
    "role": "documentation_capture",
    "brand_asset": false,
    "active_reference": false,
    "identity_refresh": "deferred"
  },
  "legacy_assets": {
    "amber_era": {
      "paths": ["governance/assets/svg", "governance/assets/png", "governance/assets/favicon", "governance/assets/social", "governance/assets/extension-branding/codestrata-extension-icon.svg"],
      "classification": "historical_archive",
      "active_product_reference_allowed": false
    },
    "retired_raster_report_logo": {
      "path": "engine/src/codestrata/reporting/assets/codestrata-logo.png",
      "classification": "removed_obsolete_active_asset",
      "replaced_by": "assessment-report-mark",
      "reason": "amber-era raster with editor metadata embedded into every report"
    },
    "aimf": {
      "visual_assets_present": false,
      "textual_history_allowed": true
    },
    "cursor": {
      "visual_assets_present": false,
      "schema_compatibility_history_allowed": true
    }
  },
  "favicon_outputs": {
    "svg": "docs/public/favicon.svg",
    "png_fallbacks": [],
    "ico": null,
    "note": "VitePress emits a single SVG favicon link; no additional consumer requires raster fallbacks."
  },
  "required_raster_sizes": [
    { "size": 128, "consumer": "vscode_marketplace_package_icon", "asset": "marketplace-icon" }
  ],
  "boundaries": {
    "marketplace_gallery": "14.6",
    "report_information_architecture": "14.9",
    "visualization_semantics": "14.8",
    "accessibility_acceptance": "14.11",
    "documentation_deployment": "14.12"
  }
}
