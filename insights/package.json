{
  "name": "codestrata-insights",
  "version": "0.2.0",
  "private": true,
  "description": "CodeStrata Community Insights internal dashboard (insights.codestrata.ai)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:upload": "wrangler deploy",
    "deploy": "npm run build && npm run deploy:check && npm run deploy:upload",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy:local": "npm run deploy"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "wrangler": "4.120.0"
  }
}
