{
  "policy_id": "codestrata-insights-application-policy",
  "policy_version": "1.0",
  "slice": "15.8",
  "epic": 15,
  "application_name": "Community Insights",
  "package_name": "codestrata-insights",
  "source_repository": "codestrata-platform",
  "future_repository": "codestrata-insights",
  "future_visibility": "private",
  "future_host": "insights.codestrata.ai",
  "product_classification": "internal_web_application",
  "not_commercial_platform_product": true,
  "source_authority": "main_monorepo_until_cutover",
  "dual_authoring_forbidden": true,
  "technology_stack": {
    "framework": "react",
    "bundler": "vite",
    "language": "typescript",
    "ssr": false,
    "rationale": "Static SPA consuming authenticated Platform APIs later; minimal deps; Cloudflare-ready; no Next.js/SSR required for internal analytics."
  },
  "monorepo_source_root": "insights/",
  "design_system_authority": "design-system/",
  "ui_must_not_compute_metrics": true,
  "no_s3_access": true,
  "no_aws_sdk_in_browser": true,
  "no_secrets_manager": true,
  "authentication_deferred_to_15_9": false,
  "metric_charts_deferred_to_15_10": false,
  "production_deploy_disabled": false,
  "production_deployment_enabled": true,
  "production_host": "insights.codestrata.ai",
  "cloudflare_project": "codestrata-insights",
  "same_origin_api_proxy": true,
  "production_ingestion_enabled": true,
  "start_slice_15_9": true,
  "robots": "noindex,nofollow",
  "export": {
    "router_target": "insights",
    "visibility": "private_internal_application",
    "manifest_schema": "insights-repository-export-manifest:1.0.0",
    "no_git_init": true,
    "remote_repository": "CodeStrata/codestrata-insights",
    "no_deploy_from_exporter": true
  },
  "privacy_forbidden_in_frontend": [
    "installation_id",
    "s3_key",
    "event_id",
    "raw_telemetry",
    "repository_name",
    "file_path",
    "customer_id",
    "source_code",
    "findings",
    "evidence",
    "prompts",
    "responses",
    "credentials",
    "endpoint",
    "exact_model_id"
  ],
  "verification": {
    "package": "verification/community_insights_application",
    "schema": "community-insights-application-verification:1.0.0",
    "report": "reports/verification/sv15-8/community-insights-application-verification.json"
  },
  "start_slice_15_10": true,
  "slice_15_9_allowed": true,
  "start_slice_15_11": true,
  "slice_15_10_allowed": true,
  "start_slice_15_12": true,
  "start_epic_16": false,
  "start_slice_16_2": false,
  "start_slice_16_3": false,
  "start_slice_16_4": false,
  "start_slice_16_5": true,
  "start_slice_16_6": true,
  "start_slice_16_7": true,
  "start_slice_16_8": true,
  "start_slice_16_9": true,
  "start_slice_16_10": true,
  "start_epic_17": false
}
