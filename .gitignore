# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*$py.class

# Compiled extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==========================================
# Virtual Environments
# ==========================================

.venv/
venv/
env/
ENV/

# ==========================================
# Testing
# ==========================================

.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ==========================================
# Type Checking
# ==========================================

.mypy_cache/
.pyright/
.pytype/

# ==========================================
# IDEs
# ==========================================

.vscode/
.idea/

# Cursor
.cursor/

# ==========================================
# Operating System
# ==========================================

.DS_Store
Thumbs.db

# ==========================================
# Environment Variables
# ==========================================

.env
.env.*
!.env.example

# ==========================================
# Logs
# ==========================================

*.log
logs/

# ==========================================
# Generated Output
# ==========================================

output/*
!output/.gitkeep

# Validation / release / inventory artifacts (never under governance/)
.generated/
.generated/validation/

# Local-only repo-root validation workspace (clones, knowledge, reports — never commit).
# Anchored to repository root so engine/validation/ (harness) remains trackable.
/validation/

# ==========================================
# Temporary Files
# ==========================================

tmp/
temp/
*.tmp

# ==========================================
# Jupyter
# ==========================================

.ipynb_checkpoints/

# ==========================================
# Local Databases
# ==========================================

*.sqlite
*.db

# ==========================================
# Local caches / embeddings
# ==========================================

vector_store/
embeddings/
cache/
chroma/
faiss_index/
artifacts/models/

# ==========================================
# Secrets
# ==========================================

*.pem
*.key
*.crt

# ==========================================
# Ruff
# ==========================================

.ruff_cache/

# ==========================================
# CodeStrata Workspace
# ==========================================

.codestrata-workspace/

# ==========================================
# GitHub Repositories (optional)
# ==========================================

# Optional local GitHub checkouts at the monorepo root only.
# Do not use a bare "repositories/" rule — it also matches
# platform/.../persistence/repositories/.
/repositories/

# CodeStrata local workspace
.codestrata/
.codestrata-test-knowledge/

# Generated analysis reports
reports/

# Never commit generated governance dumps (scripts write to .generated/)
governance/reports/
governance/archive/

# Fetched real-world showcase checkouts (never vendor upstream)
.codestrata-examples/

# Public export staging
.export-staging/

# Nested clone workspaces under local knowledge dirs
**/.codestrata/workspace/**
