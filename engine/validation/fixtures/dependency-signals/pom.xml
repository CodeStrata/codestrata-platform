<?xml version="1.0" encoding="UTF-8"?>
<!-- Controlled dependency-signals fixture. Do not execute Maven. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.codestrata.validation</groupId>
  <artifactId>dependency-signals</artifactId>
  <version>1.0.0</version>
  <properties>
    <known.lib.version>2.0.0</known.lib.version>
  </properties>
  <dependencies>
    <!-- Negative: locally resolvable property -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>known-lib</artifactId>
      <version>${known.lib.version}</version>
    </dependency>
    <!-- Positive: proven unresolved property -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>missing-prop-lib</artifactId>
      <version>${missing.version}</version>
    </dependency>
    <!-- Positive: mutable SNAPSHOT -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>snapshot-lib</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!-- Negative: exact pin -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>pinned-lib</artifactId>
      <version>3.1.4</version>
    </dependency>
    <!-- Positive: conflicting exact versions (same runtime context) -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>conflict-lib</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>conflict-lib</artifactId>
      <version>2.0.0</version>
    </dependency>
    <!-- Positive: duplicate equivalent declaration -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>dup-lib</artifactId>
      <version>1.2.3</version>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>dup-lib</artifactId>
      <version>1.2.3</version>
    </dependency>
    <!-- Negative: runtime vs test scope must not conflict -->
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>scoped-lib</artifactId>
      <version>1.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.example</groupId>
      <artifactId>scoped-lib</artifactId>
      <version>2.0.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>extra</id>
      <dependencies>
        <!-- Negative: profile-specific exact version must not conflict with main -->
        <dependency>
          <groupId>com.example</groupId>
          <artifactId>scoped-lib</artifactId>
          <version>9.9.9</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
